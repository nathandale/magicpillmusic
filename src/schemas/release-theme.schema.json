{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magicpillmusic.com/schemas/release-theme.schema.json",
  "title": "ResolvedReleaseTheme",
  "description": "Shared, versioned contract for a release's resolved theme configuration, transported to MYRADIO as the `myradio:theme-config` feed tag. DEMU (this repo) produces documents against this schema; MYRADIO's release-theme resolver validates incoming theme-config against the same schema before applying it. Both repos must keep an identical copy of this file — see the checksum test in tests/int/release-theme-schema.int.spec.ts, which fails if this file changes without a deliberate, coordinated update on both sides. Bump `themeSchemaVersion` whenever the contract changes in a way older clients cannot safely ignore.",
  "type": "object",
  "additionalProperties": false,
  "required": ["themeSchemaVersion"],
  "properties": {
    "themeSchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this schema the document conforms to. A client that does not understand this version must fall back to the named theme preset plus release/track artwork, per EO §7.8."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-release color overrides. Absent means inherit every token from the named preset; a present token overrides just that one.",
      "properties": {
        "chrome": { "$ref": "#/definitions/hexColor" },
        "muted": { "$ref": "#/definitions/hexColor" },
        "accent": { "$ref": "#/definitions/hexColor" },
        "accentContrast": { "$ref": "#/definitions/hexColor" },
        "beacon": { "$ref": "#/definitions/hexColor" },
        "beaconGlow": { "$ref": "#/definitions/hexColor" },
        "line": { "$ref": "#/definitions/hexColor" },
        "panelStart": { "$ref": "#/definitions/hexColor" },
        "panelEnd": { "$ref": "#/definitions/hexColor" },
        "panelText": { "$ref": "#/definitions/hexColor" },
        "panelMuted": { "$ref": "#/definitions/hexColor" },
        "panelAlt": { "$ref": "#/definitions/hexColor" },
        "panelActive": { "$ref": "#/definitions/hexColor" },
        "actionBackground": { "$ref": "#/definitions/hexColor" },
        "actionText": { "$ref": "#/definitions/hexColor" },
        "popoverBackground": { "$ref": "#/definitions/hexColor" },
        "popoverText": { "$ref": "#/definitions/hexColor" },
        "popoverMuted": { "$ref": "#/definitions/hexColor" }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approved release-identity assets, as absolute HTTPS/HTTP URLs resolved server-side from DEMU's Media collection. Never an arbitrary or client-supplied URL.",
      "properties": {
        "backgroundImage": { "$ref": "#/definitions/boundedUrl" },
        "textureImage": { "$ref": "#/definitions/boundedUrl" },
        "markImage": { "$ref": "#/definitions/boundedUrl" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artworkTreatment": { "type": "string", "enum": ["full", "crop", "framed"] },
        "typeTreatment": { "type": "string", "enum": ["default", "display", "mono"] },
        "surfaceTreatment": { "type": "string", "enum": ["solid", "gradient", "image", "image-gradient"] },
        "motion": { "type": "string", "enum": ["none", "subtle"] }
      }
    },
    "signalCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "type": "string", "enum": ["standard", "broadcast", "archival", "minimal"] },
        "showArtwork": { "type": "boolean" }
      }
    },
    "socialCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "type": "string", "enum": ["standard", "minimal"] }
      }
    }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "6-digit hex color, or 8-digit with alpha."
    },
    "boundedUrl": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^https?://"
    }
  }
}
